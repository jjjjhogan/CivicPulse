# Copy to .env and adjust for local development.
# .env is gitignored — never commit real secrets.

FLASK_SECRET_KEY=civicpulse-dev-only-change-me
HOST=127.0.0.1
PORT=8080

# SQLite local demo (default until Firestore cutover)
DATABASE_URL=sqlite:///data/civicpulse.db
# DATA_BACKEND=sqlite

# --- Real Firebase / Firestore (preferred for hosted + shared demo) ---
# Firebase does NOT use a Postgres-style URL. You need:
#   1) Project ID (Console → Project settings → General)
#   2) Service-account JSON (Console → Project settings → Service accounts → Generate new private key)
# DATA_BACKEND=firestore
# FIREBASE_PROJECT_ID=your-firebase-project-id
# GOOGLE_CLOUD_PROJECT=your-firebase-project-id
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/your-service-account.json
# Do NOT set FIRESTORE_EMULATOR_HOST when using the real project.

# --- Optional: local Firestore emulator (no cloud credentials) ---
# DATA_BACKEND=firestore
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
# FIREBASE_PROJECT_ID=civicpulse-local

# Optional TikTok Chrome profile (default: data/chrome/tiktok_profile)
# CIVICPULSE_CHROME_PROFILE=C:/path/to/chrome/profile
